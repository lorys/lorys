---
import Layout from '../layouts/Layout.astro';
import SocialNetworks from '../components/SocialNetworks.astro';
import SideProjects from '../components/SideProjects.astro';
import LatestPosts from '../components/LatestPosts.astro';
---

<Layout>

	<div class="home">
		<div>
			<h4 class="title">Lorys</h4>
			<h4 class="subtitle">Développeur Fullstack</h4>
		</div>
		<div>
			<SocialNetworks />
		</div>
	</div>

	<div class="split">
		<SideProjects />
		<LatestPosts />
	</div>

</Layout>

<style>
	.home {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
		gap: 16px;
	}

	.home div:first-child {
		flex: 1;
	}

	.home .title {
		font-size: clamp(20px, 6vw, 28px);
	}

	.home .title h4 {
		margin-bottom: 0px;
		padding: 0px;
		font-size: inherit;
	}
	.home .subtitle h4 {
		margin-top: 0px;
		padding: 0px;
		color: rgb(94, 94, 94);
	}

	.split {
		display: flex;
		flex-direction: row;
		gap: 2rem;
		margin-top: 40px;
	}

	.split :global(.list) {
		flex: 1;
		min-width: 0;
	}

	.split :global(.list-title) {
		margin: 0 0 12px;
	}

	.split :global(.scroll) {
		max-height: 60vh;
		overflow-y: auto;
		padding-right: 8px;
	}

	@media (max-width: 700px) {
		.split {
			flex-direction: column;
		}
	}
</style>
---
const { title, description, href, date, locale = 'fr' } = Astro.props;

const DATE_LOCALE = { fr: 'fr-FR', en: 'en-US', es: 'es-ES' };

const formatted = date
	? new Date(date).toLocaleDateString(DATE_LOCALE[locale] ?? 'fr-FR', { year: 'numeric', month: 'short', day: 'numeric' })
	: null;
---

<a class="row" href={href}>
	{formatted && <time datetime={new Date(date).toISOString()}>{formatted}</time>}
	<span class="text">
		<span class="title">{title}</span>
		{description && <span class="desc">{description}</span>}
	</span>
</a>

<style>
	.row {
		display: grid;
		grid-template-columns: 120px 1fr;
		gap: 16px;
		align-items: baseline;
		padding: 18px 12px;
		margin: 0 -12px;
		border-radius: 10px;
		text-decoration: none;
		color: inherit;
	}

	.row:hover {
		background-color: var(--surface);
		box-shadow: 0 0 0 1px var(--rule);
	}

	time {
		font-size: 15px;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.title {
		display: block;
		font-size: 19px;
		font-weight: 700;
	}

	.row:hover .title {
		color: var(--accent);
	}

	.desc {
		display: block;
		margin-top: 4px;
		color: var(--muted);
	}

	@media (max-width: 480px) {
		.row {
			grid-template-columns: 1fr;
			gap: 2px;
		}
	}
</style>

---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const { article } = Astro.props;
const { Content } = await render(article);

// The collection id is `<locale>/<slug>`, so the URL locale drives everything below.
export type AvailableLocales = undefined | "fr" | "en";

const locale: AvailableLocales = article.id.split('/')[0];

const HOME = { fr: '/', en: '/en/', es: '/es/' };
const DATE_LOCALE = { fr: 'fr-FR', en: 'en-US', es: 'es-ES' };
const BACK_LABEL = { fr: '← Retour', en: '← Back', es: '← Volver' };

const backHref = HOME[locale || 'en'] ?? '/';
const formattedDate = article.data.pubDate.toLocaleDateString(DATE_LOCALE[locale || 'en'] ?? 'fr-FR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<Layout lang={locale}>
	<article class="post">
		<a class="back" href={backHref}>{BACK_LABEL[locale || 'en']}</a>
		<h1>{article.data.title}</h1>
		<time datetime={article.data.pubDate.toISOString()}>{formattedDate}</time>
		<div class="body">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.post .back {
		display: inline-block;
		margin-bottom: 32px;
		font-weight: 600;
		text-decoration: none;
	}

	.post .back:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.post h1 {
		margin: 0 0 8px;
		font-size: clamp(32px, 7vw, 48px);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	.post time {
		display: block;
		color: var(--muted);
		padding-bottom: 32px;
		margin-bottom: 32px;
		border-bottom: 1px solid var(--rule);
	}

	.post .body {
		font-size: 18px;
		line-height: 1.65;
		max-width: 65ch;
	}

	.post .body :global(h1),
	.post .body :global(h2),
	.post .body :global(h3) {
		line-height: 1.2;
		letter-spacing: -0.01em;
		margin: 1.8em 0 0.5em;
	}

	.post .body :global(h1) {
		font-size: 26px;
	}

	.post .body :global(code) {
		font-size: 0.9em;
		padding: 1px 5px;
		background-color: var(--accent-soft);
		border-radius: 4px;
	}

	.post .body :global(pre) {
		overflow-x: auto;
		padding: 16px;
		border-radius: 10px;
		background-color: var(--surface);
		border: 1px solid var(--rule);
	}

	.post .body :global(pre code) {
		padding: 0;
		background: none;
	}

	.post .body :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 10px;
	}

	.post .body :global(table) {
		display: block;
		max-width: 100%;
		overflow-x: auto;
	}
</style>

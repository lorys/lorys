---
import { getCollection } from 'astro:content';
import PostTile from './PostTile.astro';

const { locale = 'fr' }: { locale?: 'fr' | 'en' | 'es' } = Astro.props;
const prefix = locale === 'fr' ? '' : `/${locale}`;

const TITLE = { fr: 'Articles', en: 'Articles', es: 'Artículos' };
const EMPTY = { fr: 'Aucun article pour le moment.', en: 'No articles yet.', es: 'Todavía no hay artículos.' };

const posts = (await getCollection('articles', ({ id }) => id.startsWith(`${locale}/`))).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<section class="list">
	<h2 class="list-title">{TITLE[locale] ?? 'Articles'}</h2>
	{posts.length === 0 && <p class="empty">{EMPTY[locale]}</p>}
	<ul class="rows">
		{posts.map((post) => {
			const slug = post.id.split('/').slice(1).join('/');
			return (
				<li>
					<PostTile
						title={post.data.title}
						description={post.data.description}
						href={`${prefix}/articles/${slug}/`}
						date={post.data.pubDate}
						locale={locale}
					/>
				</li>
			);
		})}
	</ul>
</section>

<style>
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.rows li + li {
		border-top: 1px solid var(--rule);
	}

	.empty {
		color: var(--muted);
	}
</style>

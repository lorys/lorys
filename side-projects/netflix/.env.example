# Folder containing the video files (scanned recursively)
MOVIES_PATH=/path/to/movies
# JSON file where TMDB results are cached (created automatically)
MOVIES_INFOS_PATH=./data/movies.json
# Encrypted accounts file, managed with `npm run accounts`
ACCOUNTS_PATH=./data/accounts.enc
# Key used to encrypt ACCOUNTS_PATH (also signs session cookies unless SESSION_SECRET is set)
ACCOUNTS_SECRET=change-me-to-a-long-random-string
# TMDB v3 API key or v4 read access token
THEMOVIEDB_API_KEY=

# Optional
# SESSION_SECRET=another-long-random-string
# PORT=3000
# HOST=0.0.0.0
# SCAN_ON_START=true
# Convert movies browsers can't play (needs ffmpeg) when the server starts; new movies are always converted
# CONVERT_ON_START=true

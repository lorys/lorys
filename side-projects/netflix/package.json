{
  "name": "netflix",
  "version": "1.0.0",
  "description": "Netflix-like streaming of a local movie folder, served with Fastify",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "scan": "node --env-file-if-exists=.env bin/scan.js",
    "accounts": "node --env-file-if-exists=.env bin/accounts.js",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.12.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  }
}
